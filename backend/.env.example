# ============================================
# CarWash Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# APP CONFIG
# ============================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:8000,http://localhost:3000
# Logging verbosity: error | warn | info | debug | verbose
LOG_LEVEL=info

# ============================================
# DATABASE (Supabase)
# ============================================
# Transaction pooler for application queries (PgBouncer, port 6543).
# Keep connection_limit low: every backend/worker replica creates its own pool.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=15&sslmode=require"
# Session pooler/direct connection for Prisma migrations (port 5432).
# Use the pooler hostname when the direct db.[ref].supabase.co host is IPv6-only.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# Warn when a Prisma query takes longer than this (ms)
PRISMA_SLOW_QUERY_MS=2000
# Stagger worker cron startup so seven jobs do not stampede the pooler.
WORKER_STARTUP_DELAY_MS=4000
WORKER_STARTUP_STAGGER_MS=2000

# ============================================
# REDIS (Upstash Free Tier)
# ============================================
# Format: redis://default:[YOUR-PASSWORD]@[YOUR-HOST]:6379
REDIS_URL="redis://default:[YOUR-UPSTASH-REDIS-PASSWORD]@[YOUR-UPSTASH-REDIS-ENDPOINT]:6379"

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET="[YOUR-JWT-SECRET]"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# STRIPE (Payment Processing)
# ============================================
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_[YOUR-STRIPE-SECRET-KEY]"
STRIPE_PUBLISHABLE_KEY="pk_test_[YOUR-STRIPE-PUBLISHABLE-KEY]"
STRIPE_WEBHOOK_SECRET="whsec_[YOUR-STRIPE-WEBHOOK-SECRET]"

# ============================================
# EMAIL (Mailgun)
# ============================================
MAILGUN_API_KEY="key-[YOUR-MAILGUN-API-KEY]"
MAILGUN_DOMAIN="mg.[YOUR-DOMAIN].com"
MAILGUN_WEBHOOK_SIGNING_KEY="[YOUR-MAILGUN-WEBHOOK-SIGNING-KEY]"
FROM_EMAIL="noreply@[YOUR-DOMAIN].com"
FROM_NAME="CarWash"

# ============================================
# SMS (MNotify)
# ============================================
MNOTIFY_API_KEY="[YOUR-MNOTIFY-API-KEY]"
MNOTIFY_SENDER_ID="CarWash"

# ============================================
# FILE STORAGE (Cloudflare R2 - Free Tier)
# ============================================
R2_ACCOUNT_ID="[YOUR-CLOUDFLARE-ACCOUNT-ID]"
R2_ACCESS_KEY_ID="[YOUR-R2-ACCESS-KEY-ID]"
R2_SECRET_ACCESS_KEY="[YOUR-R2-SECRET-ACCESS-KEY]"
R2_BUCKET_NAME="carwash-assets"
R2_PUBLIC_URL="https://[YOUR-R2-PUBLIC-DOMAIN].r2.dev"

# ============================================
# GEOCODING (Nominatim/OpenStreetMap - Free)
# ============================================
# No API key needed - just set user agent
GEOCODING_USER_AGENT="CarWash/1.0 (your-email@example.com)"

# ============================================
# MONITORING (Sentry Free Tier)
# ============================================
SENTRY_DSN="[YOUR-SENTRY-DSN]"
SENTRY_ENVIRONMENT="development"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_BOOKING=20

# ============================================
# CACHE TTL (seconds)
# ============================================
CACHE_TTL_BUSINESS=300
CACHE_TTL_SLOTS=60
CACHE_TTL_SEARCH=60
CACHE_TTL_DASHBOARD=60
