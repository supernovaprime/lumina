generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(CUSTOMER)
  phone         String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  tokenVersion  Int       @default(0)

  customer      Customer?
  business      Business?
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  gdprRequests      GdprRequest[]

  @@index([role])
  @@index([isActive])
}

model Customer {
  id              String    @id @default(uuid())
  userId          String    @unique
  firstName       String
  lastName        String
  phone           String?
  defaultVehicle  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  vehicles        Vehicle[]
  bookings        Booking[]
  favorites       Favorite[]
  reviews         Review[]
}

model Business {
  id                 String    @id @default(uuid())
  ownerId            String    @unique
  name               String
  description        String?
  address            String
  city               String
  state              String
  zipCode            String
  latitude           Float
  longitude          Float
  phone              String
  email              String
  logo               String?
  coverImage         String?
  rating             Float     @default(0)
  reviewCount        Int       @default(0)
  isVerified         Boolean   @default(false)
  isActive           Boolean   @default(true)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?
  rejectionReason    String?
  timezone           String    @default("UTC")
  operatingHours     Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner              User      @relation(fields: [ownerId], references: [id])
  services           Service[]
  bookings           Booking[]
  timeSlots          TimeSlot[]
  reviews            Review[]
  favorites          Favorite[]
  availabilityTemplate AvailabilityTemplate?
}

// ============================================
// VEHICLE
// ============================================

model Vehicle {
  id          String      @id @default(uuid())
  customerId  String
  make        String
  model       String
  year        Int
  color       String?
  licensePlate String
  type        VehicleType
  size        VehicleSize
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer    Customer    @relation(fields: [customerId], references: [id])
  bookings    Booking[]

  @@unique([customerId, licensePlate])
}

// ============================================
// SERVICE & PRICING
// ============================================

model Service {
  id              String          @id @default(uuid())
  businessId      String
  name            String
  description     String?
  category        ServiceCategory
  basePrice       Decimal         @db.Decimal(10, 2)
  durationMinutes Int
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business        Business        @relation(fields: [businessId], references: [id])
  bookings        Booking[]
  priceModifiers  PriceModifier[]

  @@index([businessId])
}

model PriceModifier {
  id          String   @id @default(uuid())
  serviceId   String
  vehicleType VehicleType
  vehicleSize VehicleSize
  multiplier  Decimal  @db.Decimal(3, 2)

  service     Service  @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, vehicleType, vehicleSize])
}

// ============================================
// AVAILABILITY & SLOTS
// ============================================

model AvailabilityTemplate {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  slotLengthMinutes  Int      @default(30)
  bufferMinutes      Int      @default(0)
  maxParallel        Int      @default(1)
  weekly             Json
  blackouts          String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business           Business @relation(fields: [businessId], references: [id])
}

model TimeSlot {
  id              String    @id @default(uuid())
  businessId      String
  date            DateTime  @db.Date
  startTime       String
  endTime         String
  isAvailable     Boolean   @default(true)
  maxBookings     Int       @default(1)
  currentBookings Int       @default(0)
  createdAt       DateTime  @default(now())

  business        Business  @relation(fields: [businessId], references: [id])
  bookings        Booking[]

  @@unique([businessId, date, startTime])
}

// ============================================
// BOOKING
// ============================================

model Booking {
  id            String        @id @default(uuid())
  customerId    String
  businessId    String
  serviceId     String
  vehicleId     String
  timeSlotId    String
  date          DateTime      @db.Date
  timeSlot      String
  status        BookingStatus @default(PENDING)
  totalPrice    Decimal       @db.Decimal(10, 2)
  notes         String?
  cancelledAt   DateTime?
  cancelledBy   String?
  cancelReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      Customer      @relation(fields: [customerId], references: [id])
  business      Business      @relation(fields: [businessId], references: [id])
  service       Service       @relation(fields: [serviceId], references: [id])
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  timeSlot_rel  TimeSlot      @relation(fields: [timeSlotId], references: [id])
  payment       Payment?
  review        Review?

  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
}

// ============================================
// PAYMENT
// ============================================

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  method          String?
  transactionId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking         Booking       @relation(fields: [bookingId], references: [id])
  refunds         Refund[]
}

// ============================================
// REFUND
// ============================================

model Refund {
  id              String       @id @default(uuid())
  paymentId       String
  amountCents     Int
  reason          String
  status          RefundStatus @default(PENDING)
  stripeRefundId  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  payment         Payment      @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([status])
}

// ============================================
// REVIEW
// ============================================

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  customerId  String
  businessId  String
  rating      Int
  comment     String?
  response    String?
  isHidden    Boolean  @default(false)
  hiddenReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking  @relation(fields: [bookingId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  business    Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([customerId])
  @@index([isHidden])
}

// ============================================
// FAVORITE
// ============================================

model Favorite {
  id          String   @id @default(uuid())
  customerId  String
  businessId  String
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])
  business    Business @relation(fields: [businessId], references: [id])

  @@unique([customerId, businessId])
}

// ============================================
// AUTH TOKENS
// ============================================

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// ============================================
// NOTIFICATION
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  channel   String
  status    String   @default("PENDING")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// AUDIT & IDEMPOTENCY
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User     @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  response  Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([key, userId])
}

model ReportJob {
  id          String       @id @default(uuid())
  adminId     String
  type        String
  status      ReportStatus @default(PENDING)
  filters     Json?
  fileUrl     String?
  rowcount    Int?
  error       String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([adminId])
  @@index([status])
}

// ============================================
// GDPR / DATA RETENTION
// ============================================

model GdprRequest {
  id          String             @id @default(uuid())
  userId      String
  type        GdprRequestType
  status      GdprRequestStatus  @default(PENDING)
  fileUrl     String?
  error       String?
  createdAt   DateTime           @default(now())
  completedAt DateTime?

  user        User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CUSTOMER
  BUSINESS
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL_REFUNDED
}

enum VehicleType {
  SEDAN
  SUV
  TRUCK
  VAN
  MOTORCYCLE
}

enum VehicleSize {
  COMPACT
  MEDIUM
  LARGE
}

enum ServiceCategory {
  EXTERIOR
  INTERIOR
  FULL_WASH
  DETAILING
  ADD_ONS
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GdprRequestType {
  DATA_EXPORT
  ACCOUNT_DELETION
}

enum GdprRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
